name: deepseek-harness-linux
title: DeepSeek Harness Linux
summary: Community Linux desktop build of DeepSeek Harness
description: |
  Community-maintained Linux x64 desktop build of DeepSeek Harness.

  This is an independent community package and is not an official
  DeepSeek product. DeepSeek Harness is developed by DeepSeek AI.
version: __VERSION__
base: core26
confinement: classic
grade: stable
license: MIT
contact: https://github.com/k0zino/dsh-linux-desktop/issues
issues: https://github.com/k0zino/dsh-linux-desktop/issues
source-code: https://github.com/k0zino/dsh-linux-desktop
website: https://github.com/k0zino/dsh-linux-desktop
icon: snap/gui/deepseek-harness-linux.png
apps:
  deepseek-harness-linux:
    command: command.sh
parts:
  app:
    plugin: dump
    source: .
    stage:
      - app
      - command.sh
