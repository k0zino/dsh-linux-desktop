# Linux packaging configuration. Copy to .env.linux (Git ignored).
# Linux targets are local-only: no signing, notarization, or auto-update feed.
# Keys not listed here are rejected; DSH_DESKTOP_APP_ID is the only required setting.

# Reverse-DNS application identifier shared by every platform target.
DSH_DESKTOP_APP_ID=com.deepseek.harness

# Optional npm registry for the bundled dsh runtime install; defaults to https://registry.npmjs.org/.
# A local mirror such as https://registry.npmmirror.com speeds up repeated local packages.
# DSH_DESKTOP_NPM_REGISTRY=https://registry.npmmirror.com
